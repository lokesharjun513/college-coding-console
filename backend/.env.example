# ============================================================
# BTECH COLLEGE CODING PLATFORM
# BACKEND ENVIRONMENT CONFIGURATION
# ============================================================
#
# Copy this file to .env for local development.
#
# PRODUCTION:
# - Never commit the real .env file.
# - Store production secrets in your hosting provider's
#   secret/environment-variable manager.
# - Never expose server-side secrets through VITE_* variables.
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

# Runtime environment.
# Production: production
# Local development: development
# Automated tests: test
NODE_ENV=production

# Express API port.
PORT=3000


# ============================================================
# DATABASE
# ============================================================

# MongoDB connection string.
#
# Production example format:
# mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>/<DATABASE>?retryWrites=true&w=majority
#
# IMPORTANT:
# - Never commit the real URI.
# - Never place this value in frontend environment variables.
# - Use a least-privilege MongoDB application user.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority


# ============================================================
# AUTHENTICATION / JWT
# ============================================================

# Strong random secret used to sign access tokens.
# REQUIRED in production.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret

# Strong random secret used to sign refresh tokens.
# REQUIRED in production.
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Access token lifetime.
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime.
REFRESH_TOKEN_TTL=7d


# ============================================================
# CORS
# ============================================================

# Production frontend origin.
#
# Example:
# CORS_ORIGIN=https://app.example.com
#
# Do not use "*" when credentialed authentication is required.
CORS_ORIGIN=https://your-frontend-domain.com,http://localhost:8080



# ============================================================
# ONLINE COMPILER / FREE CONSOLE
# ============================================================

# Base URL for the OnlineCompiler API.
# The route appends /api/run-code-sync/ automatically.
ONLINE_COMPILER_URL=https://api.onlinecompiler.io

# API key for the OnlineCompiler service.
# Required. Copy from your OnlineCompiler dashboard.
# NEVER commit the real value — use your hosting provider's secrets manager.
ONLINE_COMPILER_API_KEY=your-online-compiler-api-key

# Fallback env var name (also accepted by the route).
# ONLINE_COMPILER_KEY=your-api-key

# Execution timeout in milliseconds (default: 30000).
ONLINE_COMPILER_TIMEOUT_MS=30000

# ============================================================
# API RATE LIMITING
# ============================================================

# Global rate-limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests allowed from an IP during the global window.
RATE_LIMIT_MAX=300

# Authentication endpoint rate limit.
AUTH_RATE_LIMIT_MAX=20

# Student submission/code-execution rate limit.
SUBMISSION_RATE_LIMIT_MAX=10


# ============================================================
# TESTING ONLY
# ============================================================

# Enable rate limiting during automated tests.
#
# Normally disabled/not required for production.
ENABLE_RATE_LIMIT_IN_TESTS=false
