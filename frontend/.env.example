# ============================================================
# BTECH COLLEGE CODING PLATFORM
# FRONTEND ENVIRONMENT CONFIGURATION (VITE)
# ============================================================
#
# Copy this file to .env for local development.
#
# PRODUCTION BUILD:
# - Variables prefixed with VITE_ are bundled into the client-side
#   JavaScript code and are PUBLICLY VISIBLE in the browser.
# - NEVER store database connection strings, JWT secrets, or API keys here.
# - Configure production API URL before building static assets.
# ============================================================

# Backend API base URL
# Local development: http://localhost:3000/api
# Production: https://api.your-domain.com/api
VITE_API_URL=http://localhost:3000/api
